    <string name="text_1_information_we_collect">1. Information We Collect</string>
    <string name="smart_shelf_stores_inventory_information_such">Smart Shelf stores inventory information such as product names, categories, prices, stock quantity, and images. We also collect account information like your name and email address for authentication.</string>
