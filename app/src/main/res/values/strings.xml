    <string name="your_information_is_used_to_manage_inventory_">Your information is used to manage inventory, generate reports, synchronize your data securely using Firebase, and improve the application experience.</string>
    <string name="text_3_data_security">3. Data Security</string>
    <string name="we_use_firebase_authentication_and_firebase_d">We use Firebase Authentication and Firebase Database security rules to protect your information. Your data is encrypted during transmission.</string>
    <string name="text_4_third_party_services">4. Third Party Services</string>
    <string name="smart_shelf_integrates_firebase_services_for_">Smart Shelf integrates Firebase services for authentication, cloud database, and cloud storage. These services have their own privacy policies.</string>
    <string name="text_5_user_rights">5. User Rights</string>
    <string name="you_may_update_or_delete_your_account_informa">You may update or delete your account information at any time from your profile settings.</string>
    <string name="text_6_contact_us">6. Contact Us</string>
    <string name="if_you_have_questions_about_this_privacy_poli">If you have questions about this Privacy Policy, please contact us through the support section of Smart Shelf.</string>
