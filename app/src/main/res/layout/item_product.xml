<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProduct"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Product Icon -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_circle"
            android:padding="16dp"
            android:src="@drawable/ic_package"
            android:scaleType="centerInside"
            app:tint="#2563EB"/>

        <!-- Product Name -->
        <TextView
            android:id="@+id/txtProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgProduct"
            android:layout_marginStart="16dp"
            android:text="Wireless Mouse"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#111827"/>

        <!-- Category -->
        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtProductName"
            android:layout_toEndOf="@id/imgProduct"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_category"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Electronics"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Price -->
        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCategory"
            android:layout_toEndOf="@id/imgProduct"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:text="₹999.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2563EB"/>

        <!-- Quantity -->
        <TextView
            android:id="@+id/txtQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtPrice"
            android:layout_toEndOf="@id/imgProduct"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:text="Quantity : 15"
            android:textColor="#6B7280"
            android:textSize="14sp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_green_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="Available"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Edit Button -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="4dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#2563EB"/>

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_toStartOf="@id/btnEdit"
            android:layout_alignBottom="@id/btnEdit"
            android:layout_marginEnd="18dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#EF4444"/>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>