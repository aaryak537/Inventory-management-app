<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_dashboard_header"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Suppliers"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Manage all business suppliers"
            android:textColor="#EAF4FF"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- Search -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="#7A7A7A"/>

            <EditText
                android:id="@+id/searchSupplier"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search supplier..."
                android:textColor="#222222"
                android:textColorHint="#A0A0A0"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Statistics -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <!-- Total -->

            <androidx.cardview.widget.CardView
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginEnd="15dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="125"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#2563EB"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Total Suppliers"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Active -->

            <androidx.cardview.widget.CardView
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginEnd="15dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="102"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Active"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Pending -->

            <androidx.cardview.widget.CardView
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginEnd="15dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="23"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#F59E0B"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Pending"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Supplier List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSupplier"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddSupplier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:backgroundTint="#2563EB"
        app:elevation="10dp"/>
</LinearLayout>